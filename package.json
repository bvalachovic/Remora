{
  "name": "remora",
  "version": "0.1.0",
  "description": "Platform team design system — Lit web components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./user-profile": {
      "import": "./dist/components/user-profile/user-profile.component.js",
      "types": "./dist/types/components/user-profile/user-profile.component.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "build:storybook": "storybook build",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.18",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "publishConfig": {
    "registry": "https://gitlab.yourcompany.com/api/v4/packages/npm/",
    "access": "restricted"
  },
  "keywords": [
    "design-system",
    "web-components",
    "lit",
    "platform"
  ]
}
